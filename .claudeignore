# Claude Code ignore patterns
# Ignore environment files
.env
.env.*

# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class

# Ignore database files
*.db
*.sqlite3

# Ignore IDE settings
.vscode/
.idea/

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore build artifacts
dist/
build/
*.egg-info/
